APP_NAME=ORCA Marine Telemetry & AI Backend
APP_ENV=development
DEBUG=true
DEMO_MODE=true

HOST=0.0.0.0
PORT=8000

# Database
# For local zero-config: sqlite+aiosqlite:///./orca_marine.db
# For PostgreSQL/PostGIS: postgresql+asyncpg://postgres:postgres@localhost:5432/orca_marine
DATABASE_URL=sqlite+aiosqlite:///./orca_marine.db
SYNC_DATABASE_URL=sqlite:///./orca_marine.db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
MODEL_NAME=gemini-3.6-flash

# External Marine Data Endpoints
ISRO_BASE_URL=https://mosdac.gov.in/api/v1
MOSDAC_BASE_URL=https://mosdac.gov.in/api/v1
INCOIS_BASE_URL=https://incois.gov.in/api/v1
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Pluggable Speech Engine
STT_PROVIDER=browser
STT_API_KEY=442803ed3314499ba3e1de471c393640
TTS_PROVIDER=browser
TTS_API_KEY=442803ed3314499ba3e1de471c393640

# Safety Rules Configuration
SAFETY_WAVE_CAUTION_M=1.5
SAFETY_WAVE_DANGER_M=2.5
SAFETY_WIND_CAUTION_KMH=25.0
SAFETY_WIND_DANGER_KMH=40.0
