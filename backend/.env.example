# ORCA Backend Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

APP_NAME="ORCA Marine Telemetry & AI Backend"
APP_ENV=development
DEBUG=true
DEMO_MODE=true
DEMO_FALLBACK=true

HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./orca_marine.db
SYNC_DATABASE_URL=sqlite:///./orca_marine.db

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
MODEL_NAME=gemini-2.0-flash

# Google Maps Platform
GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_key_here
GOOGLE_MAPS_KEY=your_google_maps_browser_key_here

# Speech-to-Text (Groq Whisper)
STT_PROVIDER=groq
STT_API_KEY=your_groq_api_key_here
STT_MODEL=whisper-large-v3-turbo

# Text-to-Speech (Fish Audio)
TTS_PROVIDER=fish_audio
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
TTS_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_MODEL=s2.1-pro-free
TTS_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_VOICE_ID_EN=
FISH_AUDIO_VOICE_ID_TA=
FISH_AUDIO_VOICE_ID_ML=

# Marine Data Endpoints
ISRO_BASE_URL=https://mosdac.gov.in/api/v1
MOSDAC_BASE_URL=https://mosdac.gov.in/api/v1
INCOIS_BASE_URL=https://incois.gov.in/api/v1
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Safety Rules Configuration
SAFETY_WAVE_CAUTION_M=1.5
SAFETY_WAVE_DANGER_M=2.5
SAFETY_WIND_CAUTION_KMH=25.0
SAFETY_WIND_DANGER_KMH=40.0
