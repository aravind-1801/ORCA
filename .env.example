# ORCA Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=AQ.Ab8RN6KRDLcZATxhtxnxhqaRe821TVsZEC6eKUwDU2Du7pQ9Ow
MODEL_NAME=gemini-1.5-flash

# =============================================================================
# GOOGLE MAPS PLATFORM
# =============================================================================
# Get your key from https://console.cloud.google.com/
# Enable: Maps JavaScript API
# Restrict to: HTTP referrers (your domain / localhost)
GOOGLE_MAPS_KEY=AIzaSyDq4kTe84CYs9P0uRYbolBEe51pfe88rlk

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# DATABASE (SQLite default — change for production PostgreSQL)
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./orca_marine.db
SYNC_DATABASE_URL=sqlite:///./orca_marine.db
